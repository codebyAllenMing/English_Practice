{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "English Practice",
  "version": "1.0.0",
  "identifier": "com.allenming.english-practice",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "English Practice",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:5173; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE3RUUwQ0M4NjcwQjc0RkQKUldUOWRBdG55QXp1Rit2cFIvdGErakRDK1l2SXY2MlB3MFZ1QzhSUTFmNUFCMHMyL1Q5aU9HQWUK",
      "endpoints": [
        "https://github.com/codebyAllenMing/English_Practice/releases/latest/download/latest.json"
      ]
    }
  }
}
